# ==============================================================================
# Notes Nexus v2 Environment Variables Configuration
# ==============================================================================

# Supabase Configuration (from Supabase Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Admin Allowlist (Fixed list of 3 admin emails: founder + 2 friends, comma-separated)
ADMIN_EMAILS=founder@gmail.com,friend1@gmail.com,friend2@gmail.com
NEXT_PUBLIC_ADMIN_EMAILS=founder@gmail.com,friend1@gmail.com,friend2@gmail.com

# Site URL for OAuth callbacks and canonical metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare R2 Object Storage (Required in Phase 4 for PDFs and Listing Photos)
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2_BUCKET_NAME=notes-nexus-files
